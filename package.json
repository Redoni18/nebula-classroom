{
  "name": "nebula-classroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nebula-classroom --local",
    "db:migrate:remote": "wrangler d1 migrations apply nebula-classroom --remote",
    "preview": "corepack pnpm build:worker && opennextjs-cloudflare populateCache local && wrangler dev",
    "deploy": "node scripts/check-release.mjs && corepack pnpm build:worker && opennextjs-cloudflare populateCache remote && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "images": "node scripts/make-images.mjs",
    "build:worker": "next build && opennextjs-cloudflare build --skipNextBuild",
    "admin:add": "node scripts/add-admin.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@opennextjs/cloudflare": "1.20.13",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@11.22.0"
}
