# Public settings for production builds (inlined into the browser code at
# build time). Secrets are Worker secrets, never here.
NEXT_PUBLIC_SITE_URL=https://nebulaclassroom.com
# The Turnstile widget for nebulaclassroom.com (SPEC step 5). Until it's set,
# `corepack pnpm deploy` refuses to run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
