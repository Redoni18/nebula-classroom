// The Cloudflare Worker that runs the site (OpenNext output) and its database.
// `corepack pnpm preview` runs the built Worker locally on workerd;
// `corepack pnpm dev` reads the D1 binding from here too (next.config.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nebula-classroom",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference OpenNext uses for its cache (https://opennext.js.org/cloudflare/caching).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "nebula-classroom" }],
  // next/image resizes the photos through Cloudflare Images.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // The site answers only at its own domain; www is there to redirect to it
  // (next.config.ts). No *.workers.dev copy for search engines to find.
  "routes": [
    { "pattern": "nebulaclassroom.com", "custom_domain": true },
    { "pattern": "www.nebulaclassroom.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nebula-classroom",
      // The live database (created 2026-10-26 with --jurisdiction eu: its data
      // stays in the EU). Local runs use their own copy in .wrangler/state.
      "database_id": "7604d50d-bcb1-403e-99f7-b30eeff02f75",
      "migrations_dir": "migrations"
    }
  ],
  // Booking notifications to the owner (features/booking/server/notify.ts),
  // through Cloudflare Email Sending, which only sends from this address
  // (enabled on the domain 2026-10-26).
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["bookings@nebulaclassroom.com"] }
  ],
  // Public settings. Secrets (TURNSTILE_SECRET_KEY, IP_HASH_SALT,
  // BETTER_AUTH_SECRET) are Worker secrets in production and come from
  // .dev.vars locally.
  "vars": {}
}
